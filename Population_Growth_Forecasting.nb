Cell[TextData[StyleBox["Predictor-Corrector (ABM4) method ",
 FontColor->RGBColor[
  0.00006103608758678569, 0.0018005645838101779`, 
   0.9982299534599832]]], "Section",
 CellChangeTimes->{{3.9710503288471613`*^9, 3.971050330656761*^9}, {
   3.973055704715234*^9, 3.973055704886936*^9}, {3.977004618275187*^9, 
