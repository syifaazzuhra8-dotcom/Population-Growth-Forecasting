Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Actual", " ", "population", " ", "data"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"realData", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2015", ",", "1698100"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2016", ",", "1717700"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2017", ",", "1744100"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2018", ",", "1762800"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2019", ",", "1768800"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2020", ",", "1740400"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2021", ",", "1740000"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2022", ",", "1740900"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2023", ",", "1772600"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2024", ",", "1800500"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2025", ",", "1803300"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Population", " ", "model"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PopulationModel", "[", "K_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"r", "=", "0.0114762"}], ",", 
        RowBox[{"h", "=", "1"}], ",", 
        RowBox[{"t0", "=", "0"}], ",", 
        RowBox[{"tEnd", "=", "10"}], ",", 
        RowBox[{"P0", "=", "1698100"}], ",", "f", ",", "t", ",", "P", ",", 
        "k1", ",", "k2", ",", "k3", ",", "k4", ",", "Ppred", ",", "Pnext", ",",
         "n"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"t_", ",", "P_"}], "]"}], ":=", 
        RowBox[{"r", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           FractionBox["P", "K"]}], ")"}], " ", "P"}]}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{"Logistic", " ", "equation"}], "*)"}], "\[IndentingNewLine]", 
       
       RowBox[{"t", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"t0", ",", "tEnd", ",", "h"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"P", "=", 
        RowBox[{"{", "P0", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"RK4", " ", "starting", " ", "value"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"k1", "=", 
           RowBox[{"h", " ", 
            RowBox[{"f", "[", 
             RowBox[{
              RowBox[{"t", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"P", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"k2", "=", 
           RowBox[{"h", " ", 
            RowBox[{"f", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", 
               RowBox[{"h", "/", "2"}]}], ",", 
              RowBox[{
               RowBox[{"P", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", 
               RowBox[{"k1", "/", "2"}]}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"k3", "=", 
           RowBox[{"h", " ", 
            RowBox[{"f", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", 
               RowBox[{"h", "/", "2"}]}], ",", 
              RowBox[{
               RowBox[{"P", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", 
               RowBox[{"k2", "/", "2"}]}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"k4", "=", 
           RowBox[{"h", " ", 
            RowBox[{"f", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", "h"}], ",", 
              RowBox[{
               RowBox[{"P", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", "k3"}]}], "]"}]}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"P", ",", 
            RowBox[{
             RowBox[{"P", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"k1", "+", 
                RowBox[{"2", " ", "k2"}], "+", 
                RowBox[{"2", " ", "k3"}], "+", "k4"}], ")"}], "/", "6"}]}]}], 
           "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"AB4", " ", "predictor"}], "+", 
         RowBox[{"AM4", " ", "corrector"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Ppred", "=", 
           RowBox[{
            RowBox[{"P", "[", 
             RowBox[{"[", "n", "]"}], "]"}], "+", 
            RowBox[{
             FractionBox["h", "24"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"55", " ", 
                RowBox[{"f", "[", 
                 RowBox[{
                  RowBox[{"t", "[", 
                   RowBox[{"[", "n", "]"}], "]"}], ",", 
                  RowBox[{"P", "[", 
                   RowBox[{"[", "n", "]"}], "]"}]}], "]"}]}], "-", 
               RowBox[{"59", " ", 
                RowBox[{"f", "[", 
                 RowBox[{
                  RowBox[{"t", "[", 
                   RowBox[{"[", 
                    RowBox[{"n", "-", "1"}], "]"}], "]"}], ",", 
                  RowBox[{"P", "[", 
                   RowBox[{"[", 
                    RowBox[{"n", "-", "1"}], "]"}], "]"}]}], "]"}]}], "+", 
               RowBox[{"37", " ", 
                RowBox[{"f", "[", 
                 RowBox[{
                  RowBox[{"t", "[", 
                   RowBox[{"[", 
                    RowBox[{"n", "-", "2"}], "]"}], "]"}], ",", 
                  RowBox[{"P", "[", 
                   RowBox[{"[", 
                    RowBox[{"n", "-", "2"}], "]"}], "]"}]}], "]"}]}], "-", 
               RowBox[{"9", " ", 
                RowBox[{"f", "[", 
                 RowBox[{
                  RowBox[{"t", "[", 
                   RowBox[{"[", 
                    RowBox[{"n", "-", "3"}], "]"}], "]"}], ",", 
                  RowBox[{"P", "[", 
                   RowBox[{"[", 
                    RowBox[{"n", "-", "3"}], "]"}], "]"}]}], "]"}]}]}], 
              ")"}]}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Pnext", "=", 
           RowBox[{
            RowBox[{"P", "[", 
             RowBox[{"[", "n", "]"}], "]"}], "+", 
            RowBox[{
             FractionBox["h", "24"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"9", " ", 
                RowBox[{"f", "[", 
                 RowBox[{
                  RowBox[{"t", "[", 
                   RowBox[{"[", 
                    RowBox[{"n", "+", "1"}], "]"}], "]"}], ",", "Ppred"}], 
                 "]"}]}], "+", 
               RowBox[{"19", " ", 
                RowBox[{"f", "[", 
                 RowBox[{
                  RowBox[{"t", "[", 
                   RowBox[{"[", "n", "]"}], "]"}], ",", 
                  RowBox[{"P", "[", 
                   RowBox[{"[", "n", "]"}], "]"}]}], "]"}]}], "-", 
               RowBox[{"5", " ", 
                RowBox[{"f", "[", 
                 RowBox[{
                  RowBox[{"t", "[", 
                   RowBox[{"[", 
                    RowBox[{"n", "-", "1"}], "]"}], "]"}], ",", 
                  RowBox[{"P", "[", 
                   RowBox[{"[", 
                    RowBox[{"n", "-", "1"}], "]"}], "]"}]}], "]"}]}], "+", 
               RowBox[{"f", "[", 
                RowBox[{
                 RowBox[{"t", "[", 
                  RowBox[{"[", 
                   RowBox[{"n", "-", "2"}], "]"}], "]"}], ",", 
                 RowBox[{"P", "[", 
                  RowBox[{"[", 
                   RowBox[{"n", "-", "2"}], "]"}], "]"}]}], "]"}]}], 
              ")"}]}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"P", ",", "Pnext"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "4", ",", 
           RowBox[{
            RowBox[{"Length", "[", "t", "]"}], "-", "1"}]}], "}"}]}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"2015", ",", "2025"}], "]"}], ",", "P"}], "}"}], "]"}]}]}],
      "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Comparison", " ", 
      RowBox[{"plot", ":", " ", 
       RowBox[{"Adjustable", " ", "carrying", " ", "capacity"}]}]}], ",", " ",
      "K"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"realData", ",", 
         RowBox[{"PopulationModel", "[", "K", "]"}]}], "}"}], ",", 
       RowBox[{"PlotLegends", "->", 
